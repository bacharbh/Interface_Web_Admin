# 🌍 Smart Shepherd - Environment Configuration
# Copy this file to .env.local and fill in your values

# ============================================================================
# FRONTEND CONFIGURATION (VITE)
# ============================================================================

# Backend API URL
VITE_API_URL=http://localhost:5000/api

# Frontend URL used by backend CORS in development
FRONTEND_URL=http://localhost:5173

# MQTT WebSocket URL (for real-time telemetry)
# Development: ws://localhost:1883 (local broker)
# Production: wss://broker.mosquitto.org:8081 (public broker)
VITE_MQTT_URL=ws://localhost:1883

# MQTT Mode indicator (local|remote)
VITE_MQTT_MODE=local

# MQTT Credentials (for broker authentication)
VITE_MQTT_USERNAME=admin
VITE_MQTT_PASSWORD=admin_password

# Socket.IO URL (for real-time notifications)
VITE_SOCKET_URL=http://localhost:5000

# ============================================================================
# AI & EXTERNAL SERVICES
# ============================================================================

# OpenWeather API Key (for weather overlays on map)
# Get free key at: https://openweathermap.org/api
# Leave empty if no key is available
VITE_OPENWEATHER_KEY=

# Anthropic Claude API Key (for advanced AI analysis)
# Get key at: https://console.anthropic.com
# Leave empty to use built-in local AI analysis (85% confidence)
VITE_ANTHROPIC_API_KEY=

# ============================================================================
# BACKEND CONFIGURATION (Node.js)
# ============================================================================

# Node environment
NODE_ENV=development

# Server port
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/smart-shepherd

# JWT secret for authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Anthropic API Key (backend-side for proxying)
# Same as VITE_ANTHROPIC_API_KEY, will be used by backend
ANTHROPIC_API_KEY=

# ============================================================================
# MQTT Configuration (for IoT devices)
# ============================================================================

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=shepherd/

# ============================================================================
# EMAIL Configuration (for alerts & notifications)
# ============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@smartshepherd.app

# ============================================================================
# OPTIONAL: Third-party Integrations
# ============================================================================

# Slack webhook for critical alerts
SLACK_WEBHOOK_URL=

# Sentry error tracking
SENTRY_DSN=

# ============================================================================
# NOTES
# ============================================================================
# 
# 1. ANTHROPIC API:
#    - Optional: Leave empty to use intelligent local AI (85% confidence)
#    - With key: Get premium Claude 3.5 analysis (95% confidence)
#    - Cost: ~$0.003 per animal analysis
#
# 2. OPENWEATHER API:
#    - Free tier: 1000 calls/day
#    - Required for: Weather overlay on map
#    - Optional: Leave empty for basic map without weather
#
# 3. MQTT:
#    - Required for real-time telemetry from ESP32 collars
#    - Default Mosquitto MQTT broker on localhost:1883
#
# 4. SECURITY:
#    - Never commit .env.local to version control
#    - Use strong JWT_SECRET in production
#    - Rotate API keys regularly
#
