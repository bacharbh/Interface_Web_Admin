# Root environment variables for frontend (Vite)
# Development defaults - do NOT commit sensitive values to VCS
VITE_API_URL=http://localhost:5000/api
VITE_MQTT_URL=ws://localhost:1883
VITE_MQTT_MODE=local
VITE_SOCKET_URL=http://localhost:5000

# Optional: local Anthropic key - leave empty to use local AI
VITE_ANTHROPIC_API_KEY=
