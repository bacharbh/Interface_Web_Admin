# ==========================================
# SMART SHEPHERD BACKEND - ENV CONFIGURATION
# ==========================================

# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MONGODB CONFIGURATION
MONGODB_URI=mongodb://localhost:27017/smart-shepherd

# AUTHENTICATION
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h

# MQTT BROKER CONFIGURATION (TLS RECOMMENDED)
# Use mqtts:// for TLS connections and port 8883 instead of 1883
MQTT_BROKER_URL=mqtts://localhost:8883

# MQTT AUTHENTICATION
# Required: Do NOT use default credentials in production
MQTT_USERNAME=your_secure_mqtt_username
MQTT_PASSWORD=your_secure_mqtt_password

# MQTT TLS CERTIFICATES (Paths to the certificate files)
# Required for secure connections
MQTT_CA=./config/certs/ca.crt
MQTT_CERT=./config/certs/client.crt
MQTT_KEY=./config/certs/client.key
